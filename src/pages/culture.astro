---
import Layout from '../layouts/Layout.astro';

const books = [
  { title: "The girl with the dragon tattoo", author: "Stieg Larsson", status: "Paused" },
  { title: "The reaper", author: "Nicholas Irving with Gary Brozek", status: "Currently reading" },
];

const music = [
  { name: "Motionless in White - The Plot In You", url: "https://open.spotify.com/track/0SnvI0twJ1Mnh0rJlBRrf0?si=1f405a8981fc415a", note: "My taste to metal coming back." },
  { name: "Brother - Saul", url: "https://open.spotify.com/track/62e6FagkVKGVoXvg4bZamy?si=9f3eaca7c2c74473", note: "Makes me think about family. A good recommendation from a friend." },
];

const film = [
  { title: "The Odyssey", note: "Tried to read The Odyssey but the movie kept my attention much better." },
  { title: "Whiplash", note: "This is one of my favorite movies, so I will leave it here." },
];
---

<Layout title="Culture" activeNav="culture">
  <div class="not-prose font-serif">
    <h1 class="text-3xl font-semibold tracking-tight mb-2">Culture</h1>
    <p class="text-muted mb-8">Things I'm reading, watching, listening to, and obsessing over.</p>

    <!-- Books -->
    <h2 class="text-xl font-semibold mt-10 mb-4">Books</h2>
    <ul class="article-list">
      {books.map((b) => (
        <li>
          <span class="text-lg font-medium">{b.title}</span>
          <div class="article-date">{b.author} &mdash; {b.status}</div>
        </li>
      ))}
    </ul>

    <!-- Music -->
    <h2 class="text-xl font-semibold mt-10 mb-4">Music</h2>
    <ul class="article-list">
      {music.map((m) => (
        <li>
          <a href={m.url} class="nav-link text-lg font-medium">{m.name}</a>
          <div class="article-date">{m.note}</div>
        </li>
      ))}
    </ul>

    <!-- Film & TV -->
    <h2 class="text-xl font-semibold mt-10 mb-4">Films &amp; TV</h2>
    <ul class="article-list">
      {film.map((f) => (
        <li>
          <span class="text-lg font-medium">{f.title}</span>
          <div class="article-date">{f.note}</div>
        </li>
      ))}
    </ul>
  </div>
</Layout>
