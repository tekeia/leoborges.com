---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getPosts, getNotes, getLinks, getProjects, isoDate, hostname } from '../lib/content';

const posts = await getPosts();
const notes = await getNotes();
const links = await getLinks();
const projects = await getProjects();

const latest = posts[0];
const lastUpdated = [posts[0], notes[0], links[0]]
  .filter(Boolean)
  .map((e) => e!.data.date)
  .sort((a, b) => b.valueOf() - a.valueOf())[0];

const pages = [
  { href: '/now', label: '/now', text: "what I'm working on, learning and reading right now" },
  { href: '/uses', label: '/uses', text: 'my homelab, hardware and the tools I use every day' },
  { href: '/projects', label: '/projects', text: `${projects.length} identity, cloud and security projects` },
  { href: '/culture', label: '/culture', text: "books, music and films I'm into" },
  { href: '/rss.xml', label: '/rss.xml', text: 'everything on this site, in your feed reader' },
];
---

<Layout activeNav="home">
  <div class="not-prose">
    <p class="text-2xl leading-relaxed text-fg mb-4">
      Olá! I'm Leo. I work in identity and access management, and after hours I build (and break) a homelab
      to learn the parts of security my day job doesn't reach.
    </p>
    <p class="text-lg leading-relaxed text-soft">
      This is my corner of the web: lab write-ups, short notes, links worth your time, and whatever else
      I'm tinkering with across identity, cloud security, tech and life. Pull up a chair.
    </p>

    {latest && (
      <article class="panel mt-10">
        <div class="label mb-2">latest post</div>
        <h2 class="text-xl font-semibold m-0 mb-2 leading-snug">
          <a href={`/blog/${latest.id}`} class="nav-link">{latest.data.title}</a>
        </h2>
        {latest.data.description && <p class="text-soft m-0 mb-2">{latest.data.description}</p>}
        <p class="meta m-0">
          {isoDate(latest.data.date)}{latest.data.series && ` · ${latest.data.series}`}
        </p>
      </article>
    )}

    <p class="meta mt-6">
      last updated {lastUpdated && isoDate(lastUpdated)} · {posts.length} posts · {notes.length} notes · {links.length} links
    </p>
  </div>

  <Section
    id="blog"
    title="lab notes"
    description="Long-form write-ups from the IAM, Cloud and Security lab series."
    items={posts.slice(0, 5).map((p) => ({ href: `/blog/${p.id}`, title: p.data.title, date: p.data.date }))}
    more={{ href: '/blog', label: 'all posts' }}
  />

  <Section
    id="notes"
    title="notes"
    description="Short posts: quick findings, small wins and passing thoughts."
    items={notes.slice(0, 5).map((n) => ({ href: `/notes/${n.id}`, title: n.data.title, date: n.data.date }))}
    more={{ href: '/notes', label: 'all notes' }}
  />

  <Section
    id="links"
    title="link log"
    description="Things worth reading elsewhere, with a line or two from me."
    items={links.slice(0, 5).map((l) => ({
      href: l.data.url,
      title: l.data.title,
      date: l.data.date,
      external: true,
      meta: hostname(l.data.url),
    }))}
    more={{ href: '/links', label: 'all links' }}
  />

  <section class="not-prose mt-12" aria-labelledby="around-title">
    <h2 id="around-title" class="section-title mb-3"><span class="hash">#</span>around the site</h2>
    <ul class="entries">
      {pages.map((p) => (
        <li>
          <a href={p.href} class="nav-link mono text-sm">{p.label}</a>
          <span class="text-soft">{p.text}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="not-prose mt-12" aria-labelledby="contact-title">
    <h2 id="contact-title" class="section-title mb-3"><span class="hash">#</span>say hi</h2>
    <p class="text-soft">
      Find me on <a href="https://github.com/tekeia" class="nav-link">GitHub</a>, or follow along with the
      <a href="/rss.xml" class="nav-link">RSS feed</a>.
    </p>
  </section>
</Layout>
