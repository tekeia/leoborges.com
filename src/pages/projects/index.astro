---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPosts, getProjects, postsForProject, tagSlug } from '../../lib/content';

const projects = await getProjects();
const posts = await getPosts();

// Filter buttons: the main focus areas first, then everything else A–Z.
const priority = ['IAM', 'Cloud', 'SailPoint', 'Azure', 'Entra ID', 'Terraform'];
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))];
const tags = [
  ...priority.filter((t) => allTags.includes(t)),
  ...allTags.filter((t) => !priority.includes(t)).sort((a, b) => a.localeCompare(b)),
];
---

<Layout
  title="Projects"
  description="Identity and cloud security projects by Leo Borges: IAM labs, SailPoint, Entra ID, Azure and Terraform."
  activeNav="projects"
>
  <div class="not-prose font-serif">
    <h2 class="text-4xl font-light mb-2">Projects</h2>
    <p class="text-lg text-gray-400 mb-6">
      Identity and cloud security work I'm building and documenting. Each project links to its lab write-ups.
    </p>

    <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter projects by tag" id="tag-filter">
      <button type="button" class="tag-filter" data-tag="all" aria-pressed="true">All</button>
      {tags.map((t) => (
        <button type="button" class="tag-filter" data-tag={tagSlug(t)} aria-pressed="false">{t}</button>
      ))}
    </div>

    <div class="flex flex-col gap-4" id="project-list">
      {projects.map((p) => (
        <ProjectCard project={p} postCount={postsForProject(posts, p.id).length} />
      ))}
    </div>
    <p id="no-results" class="text-gray-400 mt-6" hidden>No projects with that tag yet.</p>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#tag-filter .tag-filter');
  const cards = document.querySelectorAll<HTMLElement>('#project-list .project-card');
  const empty = document.getElementById('no-results');

  function apply(tag: string) {
    if (![...buttons].some((b) => b.dataset.tag === tag)) tag = 'all';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
    let shown = 0;
    cards.forEach((card) => {
      const match = tag === 'all' || (card.dataset.tags ?? '').split(' ').includes(tag);
      card.hidden = !match;
      if (match) shown++;
    });
    if (empty) empty.hidden = shown > 0;

    const url = new URL(window.location.href);
    if (tag === 'all') url.searchParams.delete('tag');
    else url.searchParams.set('tag', tag);
    history.replaceState(null, '', url);
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.tag ?? 'all')));
  apply(new URLSearchParams(window.location.search).get('tag') ?? 'all');
</script>
