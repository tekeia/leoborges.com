---
import type { Project } from '../lib/content';
import { tagSlug } from '../lib/content';
import StatusLight from './StatusLight.astro';

interface Props {
  project: Project;
  postCount?: number;
}

const { project, postCount = 0 } = Astro.props;
const { title, summary, status, tags } = project.data;
---

<article
  class={`project-card${status === 'abandoned' ? ' is-abandoned' : ''}`}
  data-tags={tags.map(tagSlug).join(' ')}
>
  <div class="flex items-center justify-between gap-3 mb-2">
    <h2 class="text-xl font-medium m-0">
      <a href={`/projects/${project.id}`} class="nav-link">{title}</a>
    </h2>
    <StatusLight status={status} />
  </div>
  <p class="text-soft m-0 mb-3">{summary}</p>
  <div class="flex flex-wrap items-center gap-2">
    {tags.map((t) => <span class="tag">{t}</span>)}
    {postCount > 0 && (
      <span class="article-date m-0 ml-auto">
        {postCount} lab {postCount === 1 ? 'post' : 'posts'}
      </span>
    )}
  </div>
</article>
