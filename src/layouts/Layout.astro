---
import '../styles/global.css';

type Nav = 'home' | 'blog' | 'notes' | 'links' | 'projects' | 'now' | 'uses' | 'culture';

interface Props {
  title?: string;
  description?: string;
  activeNav?: Nav;
}

const {
  title,
  description = 'Leonardo Borges: identity and access management, cloud security, homelab notes and whatever else I am tinkering with.',
  activeNav,
} = Astro.props;

const pageTitle = title ? `${title} · Leonardo Borges` : 'Leonardo Borges';

const nav: { id: Nav; href: string; label: string }[] = [
  { id: 'blog', href: '/blog', label: 'blog' },
  { id: 'notes', href: '/notes', label: 'notes' },
  { id: 'links', href: '/links', label: 'links' },
  { id: 'projects', href: '/projects', label: 'projects' },
  { id: 'now', href: '/now', label: 'now' },
  { id: 'uses', href: '/uses', label: 'uses' },
  { id: 'culture', href: '/culture', label: 'culture' },
];
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{pageTitle}</title>
  <meta name="title" content={pageTitle} />
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="twitter:card" content="summary" />
  <meta property="twitter:title" content={pageTitle} />
  <meta property="twitter:description" content={description} />

  <meta name="theme-color" content="#0b0c0d" />
  <meta name="author" content="Leonardo Borges" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="me" href="https://www.linkedin.com/in/leolbrgs/" />
  <link rel="me" href="https://github.com/tekeia" />
  <link rel="alternate" type="application/rss+xml" title="Leonardo Borges" href="/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Apply the saved theme before paint (dark by default). -->
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t === 'light') document.documentElement.classList.remove('dark');
      else document.documentElement.classList.add('dark');
    })();
  </script>
</head>

<body class="font-serif antialiased">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-10 md:py-16">
    <header class="mb-12">
      <div class="flex items-center justify-between gap-4 mb-4">
        <a href="/" class="prompt" aria-label="Leonardo Borges, home">
          <span class="user">leo@borges</span><span class="path">:~$</span><span class="cursor" aria-hidden="true"></span>
        </a>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle light and dark theme">
          <span class="when-dark">[light]</span><span class="when-light">[dark]</span>
        </button>
      </div>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} class={activeNav === n.id ? 'active' : ''} aria-current={activeNav === n.id ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main class="prose dark:prose-invert max-w-none prose-headings:font-semibold">
      <slot />
    </main>

    <footer class="mt-16 pt-6 border-t border-line meta flex flex-wrap gap-x-4 gap-y-1">
      <span>&copy; {new Date().getFullYear()} Leonardo Borges</span>
      <a href="/rss.xml" class="nav-link">rss</a>
      <a href="https://github.com/tekeia" class="nav-link">github</a>
      <a href="https://www.linkedin.com/in/leolbrgs/" class="nav-link">linkedin</a>
      <a href="https://github.com/tekeia/leoborges.com" class="nav-link">source</a>
    </footer>
  </div>

  <style>
    :global(.dark) .when-light { display: none; }
    :global(html:not(.dark)) .when-dark { display: none; }
  </style>

  <script is:inline>
    document.getElementById('theme-toggle').addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
  </script>
</body>
</html>
